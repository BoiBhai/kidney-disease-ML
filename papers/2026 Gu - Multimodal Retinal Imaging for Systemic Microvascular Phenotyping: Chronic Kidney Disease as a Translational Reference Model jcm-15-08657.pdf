     <rdf:li>Yalin Zheng and Fang Lu</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Multimodal Retinal Imaging for Systemic Microvascular Phenotyping: Chronic Kidney Disease as a Translational Reference Model</rdf:li>
     <rdf:li xml:lang="en-US">Multimodal Retinal Imaging for Systemic Microvascular Phenotyping: Chronic Kidney Disease as a Translational Reference Model</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>retinal imaging; chronic kidney disease; artificial intelligence; risk enrichment; systemic microvascular phenotyping; multimodal imaging; clinical translation</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:type>
    <rdf:Bag>
     <rdf:li>Text</rdf:li>
    </rdf:Bag>
   </dc:type>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Multimodal retinal imaging enables repeated</rdf:li>
     <rdf:li xml:lang="en-US">Multimodal retinal imaging enables repeated</rdf:li>
     <rdf:li xml:lang="x-default">noninvasive assessment of vascular</rdf:li>
     <rdf:li xml:lang="en-US">noninvasive assessment of vascular</rdf:li>
     <rdf:li xml:lang="x-default">neuroretinal</rdf:li>
     <rdf:li xml:lang="en-US">neuroretinal</rdf:li>
     <rdf:li xml:lang="x-default">choroidal</rdf:li>
     <rdf:li xml:lang="en-US">choroidal</rdf:li>
     <rdf:li xml:lang="x-default">perfusion</rdf:li>
     <rdf:li xml:lang="en-US">perfusion</rdf:li>
     <rdf:li xml:lang="x-default">oxygenation</rdf:li>
     <rdf:li xml:lang="en-US">oxygenation</rdf:li>
     <rdf:li xml:lang="x-default">and flow-related phenotypes</rdf:li>
     <rdf:li xml:lang="en-US">and flow-related phenotypes</rdf:li>
     <rdf:li xml:lang="x-default">positioning the retina as a platform for systemic microvascular phenotyping. Chronic kidney disease (CKD) provides an informative translational reference model because estimated glomerular filtration rate (eGFR) and urinary albumin-to-creatinine ratio (UACR) offer standardized clinical anchors across disease severity and progression. This critical narrative review</rdf:li>
     <rdf:li xml:lang="en-US">positioning the retina as a platform for systemic microvascular phenotyping. Chronic kidney disease (CKD) provides an informative translational reference model because estimated glomerular filtration rate (eGFR) and urinary albumin-to-creatinine ratio (UACR) offer standardized clinical anchors across disease severity and progression. This critical narrative review</rdf:li>
     <rdf:li xml:lang="x-default">informed by structured searches of PubMed/MEDLINE</rdf:li>
     <rdf:li xml:lang="en-US">informed by structured searches of PubMed/MEDLINE</rdf:li>
     <rdf:li xml:lang="x-default">Embase</rdf:li>
     <rdf:li xml:lang="en-US">Embase</rdf:li>
     <rdf:li xml:lang="x-default">and Web of Science</rdf:li>
     <rdf:li xml:lang="en-US">and Web of Science</rdf:li>
     <rdf:li xml:lang="x-default">evaluates retinal phenotypes from biological association and longitudinal prediction to incremental clinical value</rdf:li>
     <rdf:li xml:lang="en-US">evaluates retinal phenotypes from biological association and longitudinal prediction to incremental clinical value</rdf:li>
     <rdf:li xml:lang="x-default">external validation</rdf:li>
     <rdf:li xml:lang="en-US">external validation</rdf:li>
     <rdf:li xml:lang="x-default">and implementation. Fundus photography</rdf:li>
     <rdf:li xml:lang="en-US">and implementation. Fundus photography</rdf:li>
     <rdf:li xml:lang="x-default">ultra-widefield imaging</rdf:li>
     <rdf:li xml:lang="en-US">ultra-widefield imaging</rdf:li>
     <rdf:li xml:lang="x-default">optical coherence tomography (OCT)</rdf:li>
     <rdf:li xml:lang="en-US">optical coherence tomography (OCT)</rdf:li>
     <rdf:li xml:lang="x-default">OCT angiography (OCTA)</rdf:li>
     <rdf:li xml:lang="en-US">OCT angiography (OCTA)</rdf:li>
     <rdf:li xml:lang="x-default">and functional retinal imaging provide complementary information</rdf:li>
     <rdf:li xml:lang="en-US">and functional retinal imaging provide complementary information</rdf:li>
     <rdf:li xml:lang="x-default">but retinal signals are not organ-specific. Artificial intelligence (AI)-enabled models may support automated phenotyping and opportunistic risk enrichment</rdf:li>
     <rdf:li xml:lang="en-US">but retinal signals are not organ-specific. Artificial intelligence (AI)-enabled models may support automated phenotyping and opportunistic risk enrichment</rdf:li>
     <rdf:li xml:lang="x-default">but credible translation requires appropriate comparators</rdf:li>
     <rdf:li xml:lang="en-US">but credible translation requires appropriate comparators</rdf:li>
     <rdf:li xml:lang="x-default">external validation</rdf:li>
     <rdf:li xml:lang="en-US">external validation</rdf:li>
     <rdf:li xml:lang="x-default">calibration</rdf:li>
     <rdf:li xml:lang="en-US">calibration</rdf:li>
     <rdf:li xml:lang="x-default">subgroup assessment</rdf:li>
     <rdf:li xml:lang="en-US">subgroup assessment</rdf:li>
     <rdf:li xml:lang="x-default">decision-analytic utility</rdf:li>
     <rdf:li xml:lang="en-US">decision-analytic utility</rdf:li>
     <rdf:li xml:lang="x-default">and workflow evaluation. Retinal imaging should therefore be viewed as an adjunctive platform rather than a stand-alone CKD diagnostic test</rdf:li>
     <rdf:li xml:lang="en-US">and workflow evaluation. Retinal imaging should therefore be viewed as an adjunctive platform rather than a stand-alone CKD diagnostic test</rdf:li>
     <rdf:li xml:lang="x-default">with its near-term role being to identify individuals warranting confirmatory kidney assessment when retinal images are already available and recent eGFR/UACR data are absent.</rdf:li>
     <rdf:li xml:lang="en-US">with its near-term role being to identify individuals warranting confirmatory kidney assessment when retinal images are already available and recent eGFR/UACR data are absent.</rdf:li>
    </rdf:Alt>
   </dc:description>
